# Build artifacts (regenerated by .github/workflows/release.yml; never commit)
/dist/

# Node deps (release-it tooling); pnpm-lock.yaml IS committed
/node_modules/

# IDE / editor
/.idea/

# Stray build logs
*.log

# macOS code-signing material — NEVER commit (contains the Developer ID private key).
# Used by the sign-macos job; managed locally under keychains/.
/keychains/
*.keychain-db
*.p12
